# Copy to backend/.env for local development. Never commit .env.
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=600
# Optional AI: a Groq key (gsk_…). Without it the assistant answers with quotes picked directly from the documents.
AI_API_KEY=
# Optional: models to use, best first (each has its own daily free-tier quota).
# AI_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Optional locally: Postgres with pgvector. Without it an embedded Postgres (PGlite) runs in data/runtime/pg.
# DATABASE_URL=postgres://user:password@host:5432/db
