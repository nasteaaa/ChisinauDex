# Copy to backend/.env for local development. Never commit .env.
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=100
# Optional AI: one key for any provider, recognised from its prefix:
#   sk-ant- Anthropic · sk- OpenAI · AIza Google Gemini · xai- Grok · gsk_ Groq · sk-or- OpenRouter
# Without it the assistant answers with quotes picked directly from the documents.
AI_API_KEY=
# Optional: pin a model instead of letting the backend pick one from your account.
# AI_MODEL=
# Optional locally: Postgres with pgvector. Without it an embedded Postgres (PGlite) runs in data/runtime/pg.
# DATABASE_URL=postgres://user:password@host:5432/db
