{
  "name": "backend",
  "version": "1.0.0",
  "description": "GigaHack 2026 API (Fastify + TypeScript)",
  "main": "dist/app.js",
  "scripts": {
    "test": "tsc -p test/tsconfig.json && node --import tsx --test \"test/**/*.test.ts\"",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "start": "fastify start -o -l info dist/app.js",
    "build:ts": "pnpm clean && tsc",
    "watch:ts": "tsc -w",
    "dev": "pnpm build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"pnpm:watch:ts\" \"pnpm:dev:start\"",
    "dev:start": "fastify start -o --ignore-watch=\".ts$ data\" -w -l info -P dist/app.js",
    "lint": "oxlint src test",
    "build": "pnpm build:ts",
    "crawl": "tsx scripts/crawl.ts",
    "embed": "tsx scripts/embed.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.6",
    "@huggingface/transformers": "^4.3.1",
    "cheerio": "^1.2.0",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.3",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.1",
    "fastify-tsconfig": "^3.0.0",
    "oxlint": "^1.87.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "private": true
}
